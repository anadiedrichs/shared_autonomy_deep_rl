# Graphics acceleration configuration template for Docker Compose
# To enable hardware acceleration on your machine:
#   cp docker-compose.override.yaml.example docker-compose.override.yaml
# and uncomment the section corresponding to your hardware.

# ==============================================================================
# OPTION A: Intel / AMD GPU (Standard Linux Direct Rendering Infrastructure)
# Valid for Intel Iris Xe, UHD, HD Graphics, and AMD Radeon cards
# ==============================================================================
services:
  simulador:
    devices:
      - /dev/dri:/dev/dri

# ==============================================================================
# OPTION B: Dedicated NVIDIA GPU
# Requires 'nvidia-container-toolkit' installed and configured on the host system
# ==============================================================================
# services:
#   simulador:
#     deploy:
#       resources:
#         reservations:
#           devices:
#             - driver: nvidia
#               count: all
#               capabilities: [gpu]
